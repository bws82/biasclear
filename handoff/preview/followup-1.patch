Subject: [PATCH 1/2] Pages workflow: quote pip's :all: so the file is valid
 YAML

---
 .github/workflows/pages.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.github/workflows/pages.yml b/.github/workflows/pages.yml
index cf9a86c..b4fb4d2 100644
--- a/.github/workflows/pages.yml
+++ b/.github/workflows/pages.yml
@@ -48,7 +48,7 @@ jobs:
       # Only pytest (for scripts/site_facts.py), pinned by hash with its
       # dependencies, so no unpinned package runs in the job that builds the site.
       - name: Install pytest (pinned by hash)
-        run: python -m pip install --quiet --no-deps --only-binary=:all: --require-hashes -r .github/requirements-site.txt
+        run: python -m pip install --quiet --no-deps --only-binary=":all:" --require-hashes -r .github/requirements-site.txt
 
       - name: Install the engine's build tools
         working-directory: packages/engine
-- 
