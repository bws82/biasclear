+// The price check (scripts/check-prices.mjs) against a saved copy of AWS's
+// price list, so CI needs no network. The deploy workflow runs it live.
+
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import { TEMPLATE, compare, listPrices, templateDefault } from "../scripts/check-prices.mjs";
+import { config } from "./helpers.js";
+
+const prices = JSON.parse(readFileSync(new URL("./fixtures/prices-us-east-1.json", import.meta.url).pathname, "utf8")) as {
+  products: Record<string, { attributes: Record<string, string> }>;
+  terms: { OnDemand: Record<string, Record<string, { priceDimensions: Record<string, { pricePerUnit: { USD: string } }> }>> };
+};
+const yaml = readFileSync(TEMPLATE, "utf8");
+
+describe("check-prices", () => {
+  it("finds Sonnet 5's regional Standard prices (what the US profile bills), not the Global ones", () => {
+    expect(listPrices(prices, "us.anthropic.claude-sonnet-5")).toEqual({ input: 2.2, output: 11 });
+  });
+
+  it("matches the template's defaults today", () => {
+    expect(compare(yaml, prices).ok).toBe(true);
+    expect(templateDefault(yaml, "InputPricePerMillion")).toBe("2.2");
+    expect(templateDefault(yaml, "OutputPricePerMillion")).toBe("11");
+    expect(templateDefault(yaml, "ModelId")).toBe("us.anthropic.claude-sonnet-5");
+  });
+
+  it("stops a deploy when AWS's price moves", () => {
+    const changed = structuredClone(prices);
+    for (const [sku, p] of Object.entries(changed.products)) {
+      if (p.attributes.usagetype === "USE1-MP:USE1_output_tokens_standard-Units" && (p.attributes.servicename ?? "").startsWith("Claude Sonnet 5")) {
+        for (const t of Object.values(changed.terms.OnDemand[sku]!)) {
+          for (const d of Object.values(t.priceDimensions)) d.pricePerUnit.USD = "12.0000000000";
+        }
+      }
+    }
+    expect(compare(yaml, changed).ok).toBe(false);
+  });
+
+  it("uses the same prices the function's tests use", () => {
+    const c = config();
+    expect(c.inNanosPerToken).toBe(Math.round(Number(templateDefault(yaml, "InputPricePerMillion")) * 1000));
+    expect(c.outNanosPerToken).toBe(Math.round(Number(templateDefault(yaml, "OutputPricePerMillion")) * 1000));
+  });
+});
+
+describe("the model's route (RT: the bare model ID is refused on bedrock-runtime)", () => {
+  it("the template, the function's model table and the price check all name the US inference profile", async () => {
+    const { MODELS } = await import("../src/models.js");
+    const { PRICE_KEYS } = await import("../scripts/check-prices.mjs");
+    const id = templateDefault(yaml, "ModelId");
+    expect(id).toMatch(/^us\.anthropic\./);
+    expect(Object.keys(MODELS)).toEqual([id]);
+    expect(Object.keys(PRICE_KEYS)).toEqual([id]);
+    expect(config().modelId).toBe(id);
+  });
+});
