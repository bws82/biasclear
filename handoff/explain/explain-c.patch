+    expect(h.aws.modelCalls).toHaveLength(ok);
+    expect(h.aws.table.num(DAY, "m")!).toBeLessThanOrEqual(250_000);
+    expect(h.aws.table.num(MONTH, "m")).toBe(h.aws.table.num(DAY, "m"));
+  });
+});
