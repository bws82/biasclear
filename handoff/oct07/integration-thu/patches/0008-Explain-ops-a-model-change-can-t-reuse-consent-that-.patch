+    assert "Run pause first" in fake.summary()
+    assert not fake.read_state().get("deploys")
+    assert not fake.calls(["aws", "s3"])
+    assert fake.run("ops.sh", "restore", "on").returncode == 0
+    assert fake.read_state()["stack"]["params"]["Model"] == "grok47"
+
+
