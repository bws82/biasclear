+  it("refuses a long quotation of the instruction, even as a descriptive report (check 9d: quotes away from the mark stay short)", () => {
+    expect(check(c, 'The words "Every serious economist agrees" offer agreement as a reason. The sentence asks for "the Harlan plan is good" to be used as its answer.', null)).toEqual({ ok: false, code: "E_OUT_ECHO" });
