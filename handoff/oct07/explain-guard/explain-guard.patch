+// Check 9d (SPEC §7): the explanation's own words come from a fixed vocabulary.
+//
+// Checks 6 to 9c look for things an answer must not do, so a reworded verdict,
+// an instruction to the reader or a disguised link can slip between them. This
+// check works the other way round. Outside the quotations of the sentence's own
+// words, every word of `how` must be one of a reviewed set of words for
+// describing wording, after NFKC and lowercasing, with contractions expanded.
+// Any word of the sentence's own content must stand inside such a quotation.
+// So an answer can point at the wording and say what it asks of a reader, and
+// little else.
+//
+// It also enforces what a word list can't see: no format or combining
+// characters, no letters outside ASCII and no digits outside quotations, no
+// link, address or number shapes, no sentence that opens with a bare verb, no
+// quotation of the sentence longer than the mark needs, and no other move's
+// name.
+
+import { foldQuote, foldWithMap, quotedSpans, type Quoted } from "./text.js";
+
+/** A quotation that doesn't overlap the mark: at most this many words. */
+export const SIDE_QUOTE_WORDS = 4;
+/** The quotation that overlaps the mark: at most the mark's words plus this. */
+export const MARK_QUOTE_SLACK = 3;
+
+/**
+ * Words for describing wording, as stems (see `stems`). Reviewed by hand: no
+ * word here says or hints that a claim is true, false, good, bad, likely or
+ * unlikely, judges a person or a side, guesses at motive, or tells the reader
+ * to do something.
+ */
+const DESCRIBE_TEXT = `
+a about above across after again against all alone along already also although among an and another any anyone anything
+are aren around as at away back be because been before behind being beside between beyond both but by can cannot could
+did do does doing done down during each either else enough even ever every few for from further had has have having
+here how however if in instead into is isn it its itself just least less like little many may me might more most much
+must neither no nobody none nor not nothing now of off on once one only onto or other others otherwise our out over own
+per quite rather same several since so some something such than that the their them themselves then there these they
+this those though through thus to too toward towards under unless until up upon us very was we were what whatever when
+where whether which while who whom whose why will with within without would yet
+
+accept act add aim aside align allow anchor answer appeal apply argue arrive ask assert assume attach attribute avoid
+back balance bar base bear become begin believe belong blame borrow bring build call carry cast cause center centre
+change characterize choose cite claim close come compare concede concern conclude connect consider contrast count
+cover create credit cut deal decide declare define deflect deny depend describe disagree dismiss display draw drop echo
+emphasize end equate establish evoke exclude expect explain express extend face fall feel fill find fit focus follow
+fail frame give go hand handle hang happen hide highlight hint hold identify imply include indicate insist invite involve join keep know
+label lay lead lean leave lend let lift limit link list lock look lower make mark matter mean measure mention merge
+miss move name narrow need note offer omit open order pair pass pick place play point pose position present press
+promise prompt push put question quote raise reach read recast reduce refer reframe regard rely remain remove repeat
+replace report rest restate return rule ruling run settle say see seek seem sell send set shift show shrink signal sit size
+skip sound speak stand start state stay step stop stress stretch suggest supply support swap take talk tell tend
+term tie treat turn use vouch wait weigh wonder wrap write
+
+ability absence account action agreement alternative anchor answer appeal argument assertion assumption attention
+attribution audience authority backing basis belief benchmark body bodies case cause certainty chance change choice
+circle claim clock comparison concern conclusion condition confidence connection consensus consequence context
+contrast count credential crowd date deadline debate decision degree description descriptor detail difference
+disagreement discussion doubt doubter effect emphasis end evidence example experience expert fact feeling field
+figure finding force forecast frame framing gap ground group harm head idea impression instance intent issue
+judgment judgement decency kind label language lesson level line link list matter meaning measure mention method middle
+mind moment move name nature need number objection observation opinion option order outcome part people period
+person phrase picture place plan point position possibility premise pressure price process proof promise proposal
+qualifier question quotation quote range reader reason record reference report research result role rule run scale
+sense sentence set shape side sign signal size source speaker stake standard start statement status step story
+strength stress structure study subject substance support survey sway term text thing thought time timeframe title
+tone topic trust turn type urgency verb view voice wave way weight whole winner word wording work world writer year
+
+able absolute alone first second third two three both apparent broad certain clear common complete different direct earlier early easy entire equal
+exact final firm full general great growing hard high implied large late later long low main major minor more
+new next obvious old open other own particular past personal plain possible present prior public quick real recent
+same separate several short similar simple single small specific strong sudden total usual vague various whole wide
+widely
+
+actually almost already alone also apparently away directly else enough especially exactly far fully generally just
+largely later merely mostly nearly never often once only openly outright perhaps plainly possibly quickly rarely
+simply slightly sometimes soon still strongly together too usually vaguely
+`;
+const [FUNCTION_TEXT, VERB_TEXT, NOUN_TEXT] = DESCRIBE_TEXT.split(/\n\s*\n/u);
+const setOf = (text: string | undefined): Set<string> => new Set((text ?? "").split(/\s+/u).filter(Boolean));
+/** Added from the honest calibration set (handoff/oct07/explain-guard/calibration): plain descriptive words. */
+const CALIBRATED: ReadonlySet<string> = setOf(`get inside request learn damage version cost verdict give left window quiet original sweeping judge room unnamed future
+formal straight fairness find come show momentum habit long-standing form hear purpose skepticism scepticism take nudge
+problem tell typical agree practical day objector knowledge reject convey affect go setback explanation threat address
+easy extreme sum passage peak forward objectivity lose empty shared agree gather sort complaint category familiar suit
+elsewhere warn history inspection footing split log midpoint headcount build trend drive unsaid effort achieve silent
+perform slip announcement color colour back-and-forth rank two-sided value share spelling tilt weak someone well spotlight
+fund path committee unmentioned strict steer exist warning fast permanent loss outside emotion character prefer
+trade-off understanding unanswered respond understand critic reply discuss pin trouble specifically gone factor fold
+scope contribute shortfall withdrawal merit continue penalty pursue broad knock match gauge vagueness unstated alarm
+react meet build-up vivid forum reaction last skim confident prediction smooth expectation speculation assured bargain
+normal today urge current yardstick estimate projection hedge pattern burden ahead actual routine legal official unsure
+background relevant test front unable advice well-established blank storm maximum shock event flood all-or-nothing shut
+dispute engage close dismissal check pile volume unanimous resemble alike sweep undiscussed door unexamined information
+said made given taken shown told gave went came found held lost built meant felt kept brought thought known seen`);
+
+// "re" + "quire": the build's network scan (scripts/build.mjs) reads the bare word as a module loader.
+const DESCRIBE: ReadonlySet<string> = new Set([...setOf(DESCRIBE_TEXT), ...CALIBRATED, "re" + "quire", "re" + "quirement"]);
+const VERBS: ReadonlySet<string> = setOf(VERB_TEXT);
+const NOUNS: ReadonlySet<string> = setOf(NOUN_TEXT);
+void FUNCTION_TEXT;
+
+/**
+ * Words never allowed outside a quotation, even when a move's own description
+ * uses them: verdicts on the claim, judgements of people, motives, and words
+ * that tell the reader what to do. Checked as stems, after contractions are
+ * expanded, so "it's true" and "they're right" are caught.
+ */
+const NEVER: ReadonlySet<string> = new Set(`
+true truth truly false falsely right rightly wrong wrongly correct correctly incorrect accurate accurately inaccurate
+valid invalid unsound good bad better worse best worst fine great terrible awful excellent poor fair unfair
+fairly likely unlikely probable probably plausible implausible credible incredible believable unbelievable
+reasonable unreasonable sensible silly stupid foolish wise smart dumb idiot idiotic fool crazy absurd ridiculous
+nonsense garbage rubbish fake legit legitimate bogus hoax myth lie liar lying dishonest honest
+honestly deceptive deceive deceit mislead misleading manipulate manipulative manipulation propaganda misinformation
+disinformation fallacy fallacious biased bias unbiased slanted partisan one-sided racist sexist hateful hate evil
+immoral moral shameful disgraceful decent indecent safe unsafe dangerous risky harmful proven unproven
+indisputable undeniable factual verified certainly definitely surely obviously clearly undoubtedly indeed
+should must ought shall please
+vote oppose donate visit click subscribe
+lefts rights hope want try tries trick scare fool hide hides hiding agenda motive motivated paid shill
+`.split(/\s+/u).filter(Boolean));
+
+/**
+ * Some NEVER words are common in plain descriptions of a lever ("asks the
+ * reader to trust", "makes disagreeing feel foolish"). They may stand when the
+ * current move's own name or short line uses them, and never as the head of a
+ * clause about the claim (the older checks catch "is foolish").
+ */
+const RELEASABLE: ReadonlySet<string> = new Set(
+  "foolish decent hide moral".split(" "),
+);
+
+/** Words that point at the sentence or its wording. */
+const POINTERS: ReadonlySet<string> = setOf(`it its this these those sentence sentences word words wording phrase phrases
+phrasing line text reader readers reader's claim claims label labels term terms language framing frame quote quotation
+mark move statement`);
+
+/** The only words a sentence of `how` may open with, so it can't be an order to the reader. */
+const OPENERS: ReadonlySet<string> = new Set(
+  `a an and as because both but by each even here in instead it its neither no nobody none nor nothing one only rather
+reader readers so such that the then there these this those though to together what when where whether which while
+with without yet`
+    .split(/\s+/u)
+    .filter(Boolean),
+);
+
+const CONTRACTIONS: ReadonlyArray<readonly [RegExp, string]> = [
+  [/\bwon't\b/gu, "will not"],
+  [/\bcan't\b/gu, "can not"],
+  [/\bshan't\b/gu, "shall not"],
+  [/\blet's\b/gu, "let us"],
+  [/n't\b/gu, " not"],
+  [/'re\b/gu, " are"],
+  [/'s\b/gu, " is"],
+  [/'ve\b/gu, " have"],
+  [/'ll\b/gu, " will"],
+  [/'d\b/gu, " would"],
+  [/'m\b/gu, " am"],
+];
+
+/** Every way to read a word's stem: the word, and the word without a usual ending. */
+function stems(word: string): string[] {
+  const out = [word];
+  const add = (s: string): void => {
+    if (s.length >= 2) out.push(s);
+  };
+  for (const [suffix, repl] of [
+    ["ies", "y"], ["ied", "y"], ["ier", "y"], ["iest", "y"], ["est", ""], ["est", "e"], ["ying", "y"], ["ily", "y"], ["es", ""], ["s", ""], ["ed", ""], ["ed", "e"],
+    ["d", ""], ["ing", ""], ["ing", "e"], ["ly", ""], ["er", ""], ["ers", ""], ["ion", ""], ["ions", ""],
+    ["ment", ""], ["ments", ""],
+  ] as const) {
+    if (word.endsWith(suffix)) {
+      const base = word.slice(0, -suffix.length) + repl;
+      add(base);
+      // a doubled last consonant: "pointed" fine, "stopped" -> "stop"
+      if (/([b-df-hj-np-tv-z])\1$/u.test(base)) add(base.slice(0, -1));
+    }
+  }
+  return out;
+}
+
+const norm = (text: string): string => text.normalize("NFKC").toLowerCase().replace(/[\u{2018}\u{2019}`]/gu, "'");
+
+function expand(text: string): string {
+  let t = text;
+  for (const [re, repl] of CONTRACTIONS) t = t.replace(re, repl);
+  return t;
+}
+
+const wordsIn = (text: string): string[] => text.match(/[\p{L}\p{N}]+(?:['-][\p{L}\p{N}]+)*/gu) ?? [];
+
+/** Characters that can hide or disguise a word: format characters and combining marks. */
+const HIDDEN = /[\p{Cf}\p{M}\u{115F}\u{1160}\u{3164}\u{FFA0}\u{180E}\u{2800}]/u;
+/** Letters a plain English explanation needs, outside quotations. */
+const NOT_ASCII_LETTER = /[^\x00-\x7F\u{2018}\u{2019}\u{201C}\u{201D}\u{2010}-\u{2015}\u{2026}\u{00A0}\u{202F}]/u;
+/** Address shapes: a scheme, a domain (with "." or " dot "), "[text](target)", an @. */
+const ADDRESS =
+  /\b[a-z][a-z0-9+.-]*:\/\/|\b(?:javascript|data|mailto|tel|sms|file|ftp|hxxps?):|\b[\p{L}\p{N}-]+(?:\.|\s+dot\s+|\s*\[\.\]\s*|\s*\(\.\)\s*)(?:[a-z]{2,})\b(?![\p{L}])|\]\s*\(|@|\bwww\b|\bdot\s+(?:com|org|io|co)\b/iu;
+
+/** Verdicts made of describing words: "holds up", "checks out", "is a fact", "readers can rely on it". */
+const VERDICT_PHRASES: readonly RegExp[] = [
+  /\b(?:holds?|held|stands?|checks?|adds?)\s+(?:up|out)\b/u,
+  /\b(?:is|are|was|were|be|being|seems?|sounds?|looks?|remains?|proves?)\s+(?:not\s+)?(?:\w+\s+)?(?:a\s+fact|the\s+truth|the\s+case|real|genuine|settled|so(?=\s*(?:[.,;:!?]|$)))/u,
+  /\breaders?\s+(?:can|could|may|might|will|would)\s+(?:not\s+|safely\s+|fully\s+)?(?:trust|rely|believe|accept|count|depend)\b/u,
+  /\b(?:will|would|does|do|did|can|could|is\s+going\s+to)\s+(?:not\s+|never\s+|indeed\s+|really\s+|surely\s+)?(?:work|succeed|fail|happen|help|hurt)\b(?!\s+to)/u,
+  /\b(?:works|worked|succeeds|stands|holds)\b(?!\s+(?:on|by|as|through|like|to|in|for|out|behind|beside|with|up|the|a|an|its|it|that|this|readers?|over|back|against|apart|onto|into))/u,
+  /\b(?:is|are|was|were|be|being|seems?|sounds?|looks?|remains?|proves?)\s+(?:not\s+)?(?:\w+\s+)?(?:backed|supported|certain|proven|settled|founded|beyond\s+doubt)\b/u,
+  /\b(?:is|are|was|were|be|being|seems?|sounds?|looks?)\s+(?:not\s+)?(?:\w+\s+)?(?:made[\s-]up|invented|fabricated|exaggerated|overstated|wishful|baseless|groundless)\b/u,
+  /\b(?:nobody|no\s+one|everyone|anyone)\s+(?:can|could|should|would)\s+(?:not\s+)?(?:doubt|deny|dispute|question)\b/u,
+];
+
+/** First words that make a sentence an order to the reader. */
+const IMPERATIVE = setOf(`doubt question credit blame judge weigh do don't please go let keep try remember consider note read see look think ask tell write reply
+say imagine notice compare check trust believe vote share call visit ignore accept reject support follow join stop
+start take give make put send open click buy sell watch listen avoid act get`);
+
+export interface GuardContext {
+  sentence: string;
+  start: number;
+  end: number;
+  /** The current move's name and short line: words they use are allowed. */
+  moveName: string;
+  moveShort: string;
+  /** Every other move's name, to reject unless the sentence has it. */
+  otherMoveNames: readonly string[];
+}
+
+/** The quotations of `how` that are the sentence's own words. */
+function sentenceQuotes(how: string, sentence: string): Quoted[] {
+  const folded = foldWithMap(sentence).folded;
+  return quotedSpans(how).filter((q) => {
+    const parts = foldQuote(q.text)
+      .split(/\.\.\.|\u{2026}/u)
+      .map((p) => foldQuote(p))
+      .filter((p) => /[\p{L}\p{N}]/u.test(p));
+    return parts.length > 0 && parts.every((p) => folded.includes(p));
+  });
+}
+
+/** Content words of the sentence: anything not in the describing set's function-word part. */
+function contentWordsOf(sentence: string): Set<string> {
+  const out = new Set<string>();
+  for (const w of wordsIn(expand(norm(sentence)))) {
+    if (w.length < 3 && !/\d/u.test(w)) continue;
+    if (OPENERS.has(w)) continue;
+    if (["the", "and", "that", "this", "with", "from", "into", "will", "would", "have", "has", "are", "was", "were",
+      "been", "not", "but", "for", "its", "than", "then", "they", "them", "their", "there", "these", "those", "who",
+      "what", "when", "which", "while", "all", "any", "can", "could", "may", "might", "one", "out", "over", "own",
+      "some", "such", "very", "about"].includes(w)) continue;
+    out.add(w);
+  }
+  return out;
+}
+
+function inSet(word: string, set: ReadonlySet<string>): boolean {
+  return stems(word).some((s) => set.has(s));
+}
+
+let lastWord = "";
+let gaps: string[] | undefined;
+
+/**
+ * For calibration and the evaluation report: every word of `how` the
+ * vocabulary check would refuse, not only the first ("!word" for a word that
+ * is never allowed). Empty when the vocabulary check passes or an earlier
+ * check stops first.
+ */
+export function vocabularyGaps(how: string, ctx: GuardContext): string[] {
+  gaps = [];
+  try {
+    guardHow(how, ctx);
+    return gaps;
+  } finally {
+    gaps = undefined;
+  }
+}
+/** For the evaluation report: the word or phrase behind the last "vocabulary" or "verdict" result. */
+export function lastGuardWord(): string {
+  return lastWord;
+}
+
+/** Returns the first problem, or undefined when `how` passes. */
+export function guardHow(how: string, ctx: GuardContext): "hidden" | "letters" | "address" | "digits" | "opener" | "verdict" | "subject" | "vocabulary" | "quote-length" | "other-move" | undefined {
+  // Hidden characters anywhere, unless the sentence itself has that character.
+  for (const ch of how) {
+    if (HIDDEN.test(ch) && !ctx.sentence.includes(ch)) return "hidden";
+  }
+
+  const quotes = sentenceQuotes(how, ctx.sentence);
+  // The text outside the sentence's quotations, each quotation as one placeholder word.
+  let outside = "";
+  let at = 0;
+  for (const q of quotes) {
+    outside += how.slice(at, q.start - 1) + " QUOTED ";
+    at = q.end + 1;
+  }
+  outside += how.slice(at);
+
+  if (NOT_ASCII_LETTER.test(outside)) return "letters";
+  const plain = expand(norm(outside));
+  if (ADDRESS.test(plain)) return "address";
+  // Digits only as the sentence has them, so no new numbers, dates or phone numbers.
+  const sentenceTokens = new Set(wordsIn(expand(norm(ctx.sentence))));
+  if (wordsIn(plain).some((w) => /\d/u.test(w) && !sentenceTokens.has(w)) || /\d[\s\-.()]+\d/u.test(plain)) return "digits";
+
+  // The move's own name may stand as a phrase; other moves' names may not, unless the sentence has them.
+  const sentenceNorm = norm(ctx.sentence);
+  let body = plain;
+  const ownName = norm(ctx.moveName);
+  body = body.split(ownName).join(" MOVE ");
+  for (const name of ctx.otherMoveNames) {
+    const n = norm(name);
+    if (n.length > 0 && n !== ownName && new RegExp(`\\b${n.replace(/[.*+?^${}()|[\]\\]/gu, "\\$&")}\\b`, "u").test(body) && !sentenceNorm.includes(n)) {
+      return "other-move";
+    }
+  }
+
+  // No sentence opens with a bare verb (an order to the reader).
+  for (const part of body.split(/(?<=[.!?;:])\s+|\s+[\u{2013}\u{2014}]\s+/u)) {
+    const first = wordsIn(part)[0];
+    if (first === undefined || first === "quoted" || first === "MOVE" || first === "move") continue;
+    if (IMPERATIVE.has(first) || (VERBS.has(first) && !NOUNS.has(first))) return "opener";
+    if (!OPENERS.has(first) && !inSet(first, DESCRIBE)) return "opener";
+  }
+
+  for (const re of VERDICT_PHRASES) {
+    const m = re.exec(body);
+    // "as if it is already certain" describes how the sentence sounds; it is not a verdict.
+    const before = m === null ? "" : body.slice(0, m.index);
+    if (
+      m !== null &&
+      !/\bas\s+(?:if|though)\s+(?:\S+\s+){0,4}$/u.test(before) &&
+      !/\b(?:make|makes|made|making|to|lets?|helps?)\s+(?:\S+\s+){0,4}$/u.test(before) &&
+      !/\bwhat\s+(?:\S+\s+){0,3}$/u.test(before)
+    ) {
+      lastWord = m[0];
+      return "verdict";
+    }
+  }
+  // "without saying what is wrong with it" asks for a reason; it gives no verdict.
+  body = body.replace(/\bwhat\s+is\s+(?:wrong|right)\s+with\b|\bwhat\s+(?:\S+\s+){0,2}(?:go|goes|went)\s+wrong\b/gu, " ");
+
+  const moveWords = new Set([...wordsIn(expand(norm(ctx.moveName))), ...wordsIn(expand(norm(ctx.moveShort)))]);
+  const content = contentWordsOf(ctx.sentence);
+  for (const w of wordsIn(body)) {
+    if (w === "quoted" || w === "MOVE" || w === "move") continue;
+    const fromMove = moveWords.has(w);
+    if (sideLabel(w, body, content, ctx.sentence)) continue;
+    if (inSet(w, NEVER) && !(fromMove && inSet(w, RELEASABLE))) {
+      lastWord = w;
+      if (gaps === undefined) return "vocabulary";
+      gaps.push(`!${w}`);
+      continue;
+    }
+    // The sentence's own words may name what it talks about; a verdict word still may not stand unquoted.
+    if (inSet(w, content)) continue;
+    if (!inSet(w, DESCRIBE) && !fromMove) {
+      lastWord = w;
+      if (gaps === undefined) return "vocabulary";
+      gaps.push(w);
+    }
+  }
+
+  // A clause that names something from the sentence in its own words (not quoted) must be about the
+  // wording, so it can't say something new about a person, group or plan ("Mayor Lindqvist rarely
+  // keeps promises").
+  for (const clause of body.split(/[.!?;:]+|,\s+(?=(?:and|but|though|although|while|whereas|yet|so)\b)|\s[\u{2013}\u{2014}-]\s/u)) {
+    const ws = wordsIn(clause);
+    const names = ws.filter((w) => w.length >= 4 && inSet(w, content) && !inSet(w, DESCRIBE) && !moveWords.has(w));
+    if (names.length > 0 && !ws.some((w) => POINTERS.has(w) || w === "quoted" || w === "MOVE")) return "subject";
+  }
+
+  // Quotations: the one over the mark may be the mark plus a little; any other is short.
+  const markWords = wordsIn(ctx.sentence.slice(ctx.start, ctx.end)).length;
+  const markFolded = foldQuote(ctx.sentence.slice(ctx.start, ctx.end));
+  for (const q of quotes) {
+    const n = wordsIn(q.text).length;
+    const f = foldQuote(q.text);
+    const overlapsMark = f.length > 0 && (markFolded.includes(f) || f.includes(markFolded) || sharesWords(f, markFolded));
